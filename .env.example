# 复制本文件并改名为 .env，填入自己的密钥。.env 已被 .gitignore 排除，不会上传。

# 方案一：Google Gemini（Google AI Studio 免费申请）
LLM_API_KEY=在这里填你的密钥
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# 方案二：DeepSeek（国内可直接访问，需充值少量费用）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_USE_PROXY=false   # 国内模型直连，不走系统代理

# 可选：独立审查 Agent 使用的模型（同一接口地址和密钥）。不填则和上面的模型相同。
# REVIEWER_MODEL=deepseek-reasoner

# 可选：成本统计的单价（每百万 token），用于在网页、报告和评测里显示费用。
# 不填时：deepseek-chat 用代码里的参考价（analyst/usage.py 的 DEFAULT_PRICES），其他模型只统计 token 不算钱。
# 价格会调整，请以模型官网为准。
# PRICE_INPUT=0.28          # 输入（未命中缓存）
# PRICE_INPUT_CACHED=0.028  # 输入（命中缓存）
# PRICE_OUTPUT=0.42         # 输出
# PRICE_CURRENCY=USD
